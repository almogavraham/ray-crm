rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isSuperAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'almogavraham30@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Check that the signed-in user belongs to the given workspace
    // by reading their profile document (users/{uid}.workspaceId)
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.workspaceId == workspaceId
      );
    }

    // ── Workspaces ───────────────────────────────────────────────────────────
    match /workspaces/{workspaceId} {
      // Public read for login branding (name/logoUrl only — no sensitive fields here)
      allow read:   if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.ownerId || isSuperAdmin());
      allow delete: if isSuperAdmin();

      // Workspace subcollections — only workspace members can access
      match /{subcol}/{docId} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }

      // Nested subcollections (e.g. workspaces/{id}/leads/{lid}/comments/{cid})
      match /{subcol}/{docId}/{rest=**} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }
    }

    // ── Gmail refresh tokens ─────────────────────────────────────────────────
    // Long-lived credential material. Denied to every client without exception:
    // only the Admin SDK, which bypasses these rules, may read or write it. The
    // browser is handed short-lived access tokens and never the refresh token.
    match /gmailAuth/{workspaceId} {
      allow read, write: if false;
    }
    // One-time OAuth state nonces — server-side only, same reasoning.
    match /gmailAuthNonce/{nonceId} {
      allow read, write: if false;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read:        if isSuperAdmin();
    }

    // ── Invites ──────────────────────────────────────────────────────────────
    match /invites/{token} {
      // Anyone can read an invite (needed to accept it without being logged in yet)
      allow read:   if true;
      // Only workspace owners/members can create invites
      allow create: if isSignedIn();
      // Previously superadmin-only, which broke the whole feature for everyone
      // else: `setDoc` over an existing invite counts as an UPDATE, so
      // re-inviting, resending and revoking all failed, and an invitee could
      // never mark their own invite as used. Three parties legitimately need to
      // write here:
      //   1. the superadmin,
      //   2. the invitee — identified by the email on the invite — who marks it
      //      used or deletes it when accepting,
      //   3. members of the workspace that issued it, who resend or revoke.
      allow update, delete: if isSuperAdmin()
        || (isSignedIn() && request.auth.token.email == resource.data.email)
        || (isSignedIn() && resource.data.workspaceId != null
            && isWorkspaceMember(resource.data.workspaceId));
    }

    // ── System config (feature flags, deploy settings) ───────────────────────
    match /system/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Announcements ────────────────────────────────────────────────────────
    match /announcements/{annId} {
      allow read:  if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Releases ─────────────────────────────────────────────────────────────
    match /releases/{relId} {
      allow read:  if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── Rate limit counters (written by server-side Functions only) ──────────
    // Client cannot read or write — Admin SDK bypasses rules
    match /_rateLimits/{userId}/{rest=**} {
      allow read, write: if false;
    }

    // ── Default: DENY everything else ────────────────────────────────────────
    // (replaces the previous open catch-all)
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
